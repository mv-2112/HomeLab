graph TD
    %% Custom Styling
    classDef hardware fill:#e1f5fe,stroke:#03a9f4,stroke-width:2px,color:#01579b,font-weight:bold;
    classDef cpu fill:#ffebee,stroke:#f44336,stroke-width:2px,color:#b71c1c,font-weight:bold;
    classDef external fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,color:#212121;
    classDef vlan fill:#f3e5f5,stroke:#9c27b0,stroke-width:1px,color:#4a148c;

    %% External Networks
    Internet[🌐 Public Internet] --- Deco[📡 Domestic Gateway <br> 192.168.1.254]
    Deco -->|WAN Link| Ether1

    subgraph MikroTik Router [MikroTik Core Engine]
        %% Layer 3 Elements
        Ether1(ether1 <br> 192.168.1.253/30):::cpu
        CPU_Engine{{"💻 Router CPU Engine <br> (Firewall & Routing)"}}:::cpu
        FastTrack[["⚡ FastTrack Engine <br> (Bypasses CPU for Established Traffic)"]]:::hardware
        
        Ether1 --> CPU_Engine
        CPU_Engine <--> FastTrack
        
        %% Layer 2 Switch Hardware Table
        subgraph Switch_Chip [🔒 Switch Chip Hardware Acceleration]
            Bridge[Master Trunk Bridge <br> vlan-filtering=yes]:::hardware
            
            %% Switch Ports
            P2(ether2 <br> Hybrid Port):::hardware
            P3(ether3 <br> Hybrid Port):::hardware
            P4(ether4 <br> Hybrid Port):::hardware
            P5(ether5 <br> Hybrid Port):::hardware
            
            Bridge --- P2
            Bridge --- P3
            Bridge --- P4
            Bridge --- P5
        end
        
        %% VLAN Subsystem Layout
        CPU_Engine <--> |Inter-VLAN Routing & Drop Rules| Bridge
        
        V_Native[Management LAN <br> Untagged / PVID 1]:::vlan
        V_20[IoT Network <br> VLAN 20]:::vlan
        V_30[Guest Network <br> VLAN 30]:::vlan
        V_40[Security Cameras <br> VLAN 40]:::vlan
        V_50[Home Lab <br> VLAN 50]:::vlan
        V_60[Storage NAS <br> VLAN 60]:::vlan
        
        Bridge -.-> V_Native
        Bridge -.-> V_20
        Bridge -.-> V_30
        Bridge -.-> V_40
        Bridge -.-> V_50
        Bridge -.-> V_60
    end

    %% Downstream Traffic Indicators
    P2 & P3 & P4 & P5 ===>|100% HW Offloaded L2 Traffic| Downstream[💻 Hybrid Devices & Untagged Equipment]:::external

    %% Diagram Legends / Visual Notes
    linkStyle 4,5,6,7,8 stroke:#03a9f4,stroke-width:3px;
    linkStyle 9,15 stroke:#f44336,stroke-width:2px;
