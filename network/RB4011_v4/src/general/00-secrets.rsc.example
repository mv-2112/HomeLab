# Secrets for the build. Copy to 00-secrets.rsc (git-ignored) and fill in:
#   cp src/general/00-secrets.rsc.example src/general/00-secrets.rsc
# build.sh puts it first and removes the variable again at the end of the
# import, so the password isn't left in the router's script environment.

:global pppoePassword "CHANGEME"
